        def OmniGraphNode "ToDoubleW"
        {
            custom token inputs:role (
                allowedTokens = ["None", "Color", "Frame", "Matrix", "Normal", "Point", "Quaternion", "TexCoord", "Timecode", "Vector"]
            )
            custom token inputs:value
            prepend token inputs:value.connect = </Graphs/differential_controller/W.outputs:isPressed>
            token node:type = "omni.graph.nodes.ToDouble"
            int node:typeVersion = 1
            custom token outputs:converted
        }

        def OmniGraphNode "ToDoubleA"
        {
            custom token inputs:role (
                allowedTokens = ["None", "Color", "Frame", "Matrix", "Normal", "Point", "Quaternion", "TexCoord", "Timecode", "Vector"]
            )
            custom token inputs:value
            prepend token inputs:value.connect = </Graphs/differential_controller/A.outputs:isPressed>
            token node:type = "omni.graph.nodes.ToDouble"
            int node:typeVersion = 1
            custom token outputs:converted
        }

        def OmniGraphNode "ToDoubleS"
        {
            custom token inputs:role (
                allowedTokens = ["None", "Color", "Frame", "Matrix", "Normal", "Point", "Quaternion", "TexCoord", "Timecode", "Vector"]
            )
            custom token inputs:value
            prepend token inputs:value.connect = </Graphs/differential_controller/S.outputs:isPressed>
            token node:type = "omni.graph.nodes.ToDouble"
            int node:typeVersion = 1
            custom token outputs:converted
        }

        def OmniGraphNode "ToDoubleD"
        {
            custom token inputs:role (
                allowedTokens = ["None", "Color", "Frame", "Matrix", "Normal", "Point", "Quaternion", "TexCoord", "Timecode", "Vector"]
            )
            custom token inputs:value
            prepend token inputs:value.connect = </Graphs/differential_controller/D.outputs:isPressed>
            token node:type = "omni.graph.nodes.ToDouble"
            int node:typeVersion = 1
            custom token outputs:converted
        }

        def OmniGraphNode "NegateLinear"
        {
            custom token inputs:a
            prepend token inputs:a.connect = </Graphs/differential_controller/ToDoubleS.outputs:converted>
            custom token inputs:b
            prepend token inputs:b.connect = </Graphs/differential_controller/NegOne.inputs:value>
            token node:type = "omni.graph.nodes.Multiply"
            int node:typeVersion = 2
            custom token outputs:product
        }

        def OmniGraphNode "NegateAngular"
        {
            custom token inputs:a
            prepend token inputs:a.connect = </Graphs/differential_controller/ToDoubleD.outputs:converted>
            custom token inputs:b
            prepend token inputs:b.connect = </Graphs/differential_controller/NegOne.inputs:value>
            token node:type = "omni.graph.nodes.Multiply"
            int node:typeVersion = 2
            custom token outputs:product
        }

        def OmniGraphNode "AddLinear"
        {
            custom token inputs:a
            prepend token inputs:a.connect = </Graphs/differential_controller/ToDoubleW.outputs:converted>
            custom token inputs:b
            prepend token inputs:b.connect = </Graphs/differential_controller/NegateLinear.outputs:product>
            token node:type = "omni.graph.nodes.Add"
            int node:typeVersion = 2
            custom token outputs:sum
        }

        def OmniGraphNode "AddAngular"
        {
            custom token inputs:a
            prepend token inputs:a.connect = </Graphs/differential_controller/ToDoubleA.outputs:converted>
            custom token inputs:b
            prepend token inputs:b.connect = </Graphs/differential_controller/NegateAngular.outputs:product>
            token node:type = "omni.graph.nodes.Add"
            int node:typeVersion = 2
            custom token outputs:sum
        }

        def OmniGraphNode "SpeedLinear"
        {
            custom token inputs:a
            prepend token inputs:a.connect = </Graphs/differential_controller/AddLinear.outputs:sum>
            custom token inputs:b
            prepend token inputs:b.connect = </Graphs/differential_controller/ScaleLinear.inputs:value>
            token node:type = "omni.graph.nodes.Multiply"
            int node:typeVersion = 2
            custom token outputs:product
        }

        def OmniGraphNode "ScaleLinear"
        {
            custom double inputs:value = 5
            token node:type = "omni.graph.nodes.ConstantDouble"
            int node:typeVersion = 1
        }

        def OmniGraphNode "SpeedAngular"
        {
            custom token inputs:a
            prepend token inputs:a.connect = </Graphs/differential_controller/AddAngular.outputs:sum>
            custom token inputs:b
            prepend token inputs:b.connect = </Graphs/differential_controller/ScaleAngular.inputs:value>
            token node:type = "omni.graph.nodes.Multiply"
            int node:typeVersion = 2
            custom token outputs:product
        }

        def OmniGraphNode "ScaleAngular"
        {
            custom double inputs:value = 6
            token node:type = "omni.graph.nodes.ConstantDouble"
            int node:typeVersion = 1
        }

        def OmniGraphNode "NegOne"
        {
            custom int inputs:value = -1
            token node:type = "omni.graph.nodes.ConstantInt"
            int node:typeVersion = 1
        }
    }

    def OmniGraph "ROS2_LidarStream"
    {
        token evaluationMode = "Automatic"
        token evaluator:type = "execution"
        token fabricCacheBacking = "StageWithoutHistory"
        int2 fileFormatVersion = (1, 9)
        token pipelineStage = "pipelineStageSimulation"

        def OmniGraphNode "isaac_read_lidar_beams_node" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            custom uint inputs:execIn (
                customData = {
                    bool isExecution = 1
                }
            )
            prepend uint inputs:execIn.connect = </Graphs/ROS2_LidarStream/on_playback_tick.outputs:tick>
            custom rel inputs:lidarPrim = </World/SimpleRobot/Front_Sensor/Lidar> (
                customData = {
                    dictionary omni = {
                        dictionary graph = {
                            string relType = "target"
                        }
                    }
                }
            )
            token node:type = "isaacsim.sensors.physx.IsaacReadLidarBeams"
            int node:typeVersion = 1
            custom float2 outputs:azimuthRange
            custom float[] outputs:beamTimeData
            custom float2 outputs:depthRange
            custom uint outputs:execOut (
                customData = {
                    bool isExecution = 1
                }
            )
            custom float outputs:horizontalFov
            custom float outputs:horizontalResolution
            custom uchar[] outputs:intensitiesData
            custom float[] outputs:linearDepthData
            custom int outputs:numCols
            custom int outputs:numRows
            custom float outputs:rotationRate
            custom float outputs:verticalFov
            custom float outputs:verticalResolution
            custom float2 outputs:zenithRange
            uniform token ui:nodegraph:node:expansionState = "open"
            uniform float2 ui:nodegraph:node:pos = (426, 63)
        }

        def OmniGraphNode "ros2_publish_laser_scan" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            custom float2 inputs:azimuthRange
            prepend float2 inputs:azimuthRange.connect = </Graphs/ROS2_LidarStream/isaac_read_lidar_beams_node.outputs:azimuthRange>
            custom uint64 inputs:bufferSize
            custom uint64 inputs:context
            custom uint64 inputs:dataPtr
            custom float2 inputs:depthRange
            prepend float2 inputs:depthRange.connect = </Graphs/ROS2_LidarStream/isaac_read_lidar_beams_node.outputs:depthRange>
            custom uint inputs:execIn (
                customData = {
                    bool isExecution = 1
                }
            )
            prepend uint inputs:execIn.connect = </Graphs/ROS2_LidarStream/isaac_read_lidar_beams_node.outputs:execOut>
            custom string inputs:frameId
            custom float inputs:horizontalFov
            prepend float inputs:horizontalFov.connect = </Graphs/ROS2_LidarStream/isaac_read_lidar_beams_node.outputs:horizontalFov>
            custom float inputs:horizontalResolution
            prepend float inputs:horizontalResolution.connect = </Graphs/ROS2_LidarStream/isaac_read_lidar_beams_node.outputs:horizontalResolution>
            custom uchar[] inputs:intensitiesData
            prepend uchar[] inputs:intensitiesData.connect = </Graphs/ROS2_LidarStream/isaac_read_lidar_beams_node.outputs:intensitiesData>
            custom float[] inputs:linearDepthData
            prepend float[] inputs:linearDepthData.connect = </Graphs/ROS2_LidarStream/isaac_read_lidar_beams_node.outputs:linearDepthData>
            custom string inputs:nodeNamespace
            custom int inputs:numCols
            prepend int inputs:numCols.connect = </Graphs/ROS2_LidarStream/isaac_read_lidar_beams_node.outputs:numCols>
            custom int inputs:numRows
            prepend int inputs:numRows.connect = </Graphs/ROS2_LidarStream/isaac_read_lidar_beams_node.outputs:numRows>
            custom string inputs:qosProfile
            custom uint64 inputs:queueSize
            custom float inputs:rotationRate
            prepend float inputs:rotationRate.connect = </Graphs/ROS2_LidarStream/isaac_read_lidar_beams_node.outputs:rotationRate>
            custom double inputs:timeStamp
            prepend double inputs:timeStamp.connect = </Graphs/ROS2_LidarStream/isaac_read_simulation_time.outputs:simulationTime>
            custom string inputs:topicName = "scan_lidar"
            token node:type = "isaacsim.ros2.bridge.ROS2PublishLaserScan"
            int node:typeVersion = 3
            uniform token ui:nodegraph:node:expansionState = "open"
            uniform float2 ui:nodegraph:node:pos = (804, 50)
        }

        def OmniGraphNode "isaac_read_simulation_time" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            custom uint64 inputs:referenceTimeDenominator
            custom int64 inputs:referenceTimeNumerator
            custom bool inputs:resetOnStop
            token node:type = "isaacsim.core.nodes.IsaacReadSimulationTime"
            int node:typeVersion = 1
            custom double outputs:simulationTime
            uniform token ui:nodegraph:node:expansionState = "open"
            uniform float2 ui:nodegraph:node:pos = (426.8921, 543.1939)
        }

        def OmniGraphNode "on_playback_tick" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            token node:type = "omni.graph.action.OnPlaybackTick"
            int node:typeVersion = 2
            custom double outputs:deltaSeconds
            custom double outputs:frame
            custom uint outputs:tick (
                customData = {
                    bool isExecution = 1
                }
            )
            custom double outputs:time
            uniform token ui:nodegraph:node:expansionState = "open"
            uniform float2 ui:nodegraph:node:pos = (120.78789, 96.21591)
        }
    }
}

